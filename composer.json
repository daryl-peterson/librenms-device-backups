{
    "name": "daryl-peterson/librenms-device-backups",
    "description": "LibreNMS plugin for device backups",
    "keywords": [
        "librenms",
        "plugin",
        "device backups",
        "backups",
        "device management",
        "sftp",
        "snmp"
    ],
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "daryl-peterson",
            "email": "daryl.peterson@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "librenms/plugin-interfaces": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DRP\\DeviceBackups\\": "src/"
        }
    },
     "extra": {
        "laravel": {
            "providers": [
                "DRP\\DeviceBackups\\PluginProvider"
            ],
            "aliases": {
                "DeviceBackups": "DRP\\DeviceBackups\\Facades\\DeviceBackups"
            }
        }
    },
    "minimum-stability": "dev"

}
