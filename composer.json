{
    "name": "daryl-peterson/librenms-device-backups",
    "description": "LibreNMS plugin for device backups",
    "keywords": [
        "librenms",
        "plugin",
        "device backups",
        "backups",
        "device management",
        "snmp"
    ],
    "type": "library",
    "license": "MIT",
    "funding": [
        {
        "type": "github",
        "url": "https://github.com/sponsors/daryl-peterson"
        },
        {
            "type": "other",
            "url": "https://buymeacoffee.com"
        }
    ],
    "authors": [
        {
            "name": "daryl-peterson",
            "email": "daryl.peterson@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "librenms/plugin-interfaces": "^1.0",
        "phpseclib/phpseclib": "^4.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "laravel/framework": "^13.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "DRP\\DeviceBackups\\": "src/"
        },
        "files": [
            "src/constants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DRP\\DeviceBackups\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "vendor-dir": ".test-vendor"
    },
    "extra": {
        "laravel": {
            "providers": [
                "DRP\\DeviceBackups\\PluginProvider"
            ],
            "aliases": {
                "DeviceBackups": "DRP\\DeviceBackups\\Facades\\DeviceBackups"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
